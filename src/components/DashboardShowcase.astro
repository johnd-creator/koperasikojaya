---
---
<section class="dashboard-showcase-section">
  <div class="container showcase-container">
    <!-- Left Column: Copywriting & Feature Pills -->
    <div class="showcase-content" data-animate="fade-up">
      <span class="section-tag">Sistem Manajemen Terintegrasi</span>
      <h2 class="showcase-title">
        Pengelolaan TAD, HRM, dan Payroll yang Lebih Profesional
      </h2>
      <p class="showcase-subtitle">
        KOJAYA mengembangkan proses kerja yang lebih tertata untuk pengelolaan tenaga kerja, absensi, administrasi personalia, hingga penggajian, agar layanan yang diberikan semakin terpercaya dan siap digunakan oleh mitra.
      </p>

      <div class="feature-pills-row">
        <div class="showcase-pill" data-animate="fade-up" data-delay="100">
          <div class="pill-icon-box">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="pill-text">
            <h4>Administrasi SDM</h4>
            <p>Data personalia lengkap, terstruktur, dan aman.</p>
          </div>
        </div>

        <div class="showcase-pill" data-animate="fade-up" data-delay="200">
          <div class="pill-icon-box">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>
          </div>
          <div class="pill-text">
            <h4>Payroll & Rekap</h4>
            <p>Perhitungan gaji akurat dan rekap laporan rapi.</p>
          </div>
        </div>

        <div class="showcase-pill" data-animate="fade-up" data-delay="300">
          <div class="pill-icon-box">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg>
          </div>
          <div class="pill-text">
            <h4>Monitoring Kinerja</h4>
            <p>Pantau kehadiran dan kinerja secara real-time.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive HTML/SVG Dashboard UI Mockup -->
    <div class="dashboard-mockup-wrapper" data-animate="scale-up" data-delay="200">
      <div class="app-window">
        <!-- App Header Bar -->
        <div class="app-sidebar">
          <div class="sidebar-logo">
            <span class="live-pulse-dot"></span>
            <span>KOJAYA</span>
          </div>
          <div class="sidebar-menu">
            <div class="menu-item active">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              <span>Dashboard</span>
            </div>
            <div class="menu-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
              <span>Karyawan</span>
            </div>
            <div class="menu-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>Absensi</span>
            </div>
            <div class="menu-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><line x1="12" x2="12" y1="8" y2="16"/></svg>
              <span>Payroll</span>
            </div>
            <div class="menu-item">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/></svg>
              <span>Laporan</span>
            </div>
          </div>
        </div>

        <!-- Main Dashboard Content -->
        <div class="app-main">
          <div class="app-topbar">
            <h3 class="dash-title">Dashboard Operasional</h3>
            <div class="user-badge">
              <span class="live-pulse-dot"></span>
              <div class="user-avatar">AK</div>
              <span>Admin KOJAYA</span>
            </div>
          </div>

          <!-- 3 Stats Cards -->
          <div class="stats-row">
            <div class="stat-card">
              <span class="stat-label">Total Karyawan</span>
              <div class="stat-val">1.248</div>
              <span class="stat-trend positive">+6,2% <span class="trend-sub">bulan ini</span></span>
            </div>
            <div class="stat-card">
              <span class="stat-label">Kehadiran Hari Ini</span>
              <div class="stat-val">96,4%</div>
              <span class="stat-badge">Tepat waktu</span>
            </div>
            <div class="stat-card">
              <span class="stat-label">Payroll Bulan Ini</span>
              <div class="stat-val">Rp 4,85 M</div>
              <span class="stat-badge">Siap dibayarkan</span>
            </div>
          </div>

          <!-- Charts Row -->
          <div class="charts-row">
            <!-- Line Chart: Ringkasan Kehadiran -->
            <div class="chart-card flex-2">
              <div class="chart-header-row">
                <h4 class="chart-header">Ringkasan Kehadiran</h4>
                <span class="live-tag">Live</span>
              </div>
              <div class="line-chart-box">
                <svg viewBox="0 0 300 100" class="svg-chart">
                  <path d="M10,80 Q50,40 90,65 T170,25 T250,50 T290,20" fill="none" stroke="#78C800" stroke-width="3" stroke-linecap="round"/>
                  <path d="M10,80 Q50,40 90,65 T170,25 T250,50 T290,20 L290,100 L10,100 Z" fill="url(#greenGrad)" opacity="0.15"/>
                  <defs>
                    <linearGradient id="greenGrad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stop-color="#78C800"/>
                      <stop offset="100%" stop-color="#FFFFFF"/>
                    </linearGradient>
                  </defs>
                    <circle cx="290" cy="20" r="4" fill="#062B55"/>
                </svg>
                <div class="chart-days">
                  <span>Sen</span>
                  <span>Sel</span>
                  <span>Rab</span>
                  <span>Kam</span>
                  <span>Jum</span>
                  <span>Sab</span>
                </div>
              </div>
            </div>

            <!-- Donut Chart: Komposisi Karyawan -->
            <div class="chart-card flex-1">
              <h4 class="chart-header">Komposisi SDM</h4>
              <div class="donut-chart-box">
                <div class="donut-svg-wrapper">
                  <svg viewBox="0 0 36 36" class="donut-svg">
                    <!-- Segment 1: Operasional (62%) -->
                    <circle cx="18" cy="18" r="15.9" fill="transparent" stroke="#78C800" stroke-width="5" stroke-dasharray="62 38" stroke-dashoffset="25"></circle>
                    <!-- Segment 2: Teknis (23%) -->
                    <circle cx="18" cy="18" r="15.9" fill="transparent" stroke="#2563EB" stroke-width="5" stroke-dasharray="23 77" stroke-dashoffset="-37"></circle>
                    <!-- Segment 3: Administrasi (15%) -->
                    <circle cx="18" cy="18" r="15.9" fill="transparent" stroke="#94A3B8" stroke-width="5" stroke-dasharray="15 85" stroke-dashoffset="-60"></circle>
                  </svg>
                </div>
                <div class="donut-legend">
                  <div class="legend-item"><span class="color-dot dot-op"></span><span>Operasional <b>62%</b></span></div>
                  <div class="legend-item"><span class="color-dot dot-tek"></span><span>Teknis <b>23%</b></span></div>
                  <div class="legend-item"><span class="color-dot dot-adm"></span><span>Administrasi <b>15%</b></span></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .dashboard-showcase-section {
    padding: 6rem 0;
    background-color: var(--bg-subtle);
    border-top: 1px solid var(--border-light);
    border-bottom: 1px solid var(--border-light);
    position: relative;
  }

  .showcase-container {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 3.5rem;
    align-items: center;
  }

  .showcase-title {
    font-size: 2.25rem;
    font-weight: 800;
    line-height: 1.25;
    color: var(--text-main);
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .showcase-subtitle {
    font-size: 1rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 2rem;
  }

  .feature-pills-row {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .showcase-pill {
    display: flex;
    align-items: center;
    gap: 1rem;
    background-color: #FFFFFF;
    border: 1px solid var(--border-light);
    padding: 0.85rem 1.1rem;
    border-radius: 14px;
    box-shadow: var(--shadow-sm);
    transition: all 0.25s ease;
  }

  .showcase-pill:hover {
    border-color: var(--primary-accent);
    transform: translateX(4px);
    box-shadow: var(--shadow-md);
  }

  .pill-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: var(--pill-green-bg);
    color: var(--primary-dark);
    border-radius: 10px;
    flex-shrink: 0;
  }

  .pill-text h4 {
    font-size: 0.925rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.15rem;
  }

  .pill-text p {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  /* App Window UI Mockup */
  .app-window {
    display: flex;
    background: #FFFFFF;
    border-radius: 20px;
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--border-light);
    overflow: hidden;
    min-height: 380px;
  }

  .app-sidebar {
    width: 140px;
    background-color: var(--dark-bg);
    color: #FFFFFF;
    padding: 1.25rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
    padding-left: 0.25rem;
  }

  .sidebar-menu {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .menu-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.775rem;
    padding: 0.5rem 0.6rem;
    border-radius: 8px;
    color: #94A3B8;
    cursor: pointer;
  }

  .menu-item.active {
    background-color: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    font-weight: 600;
  }

  .app-main {
    flex: 1;
    padding: 1.25rem;
    background-color: #F8FAFC;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .app-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .dash-title {
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .user-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-secondary);
  }

  .user-avatar {
    width: 24px;
    height: 24px;
    background-color: var(--primary-dark);
    color: #FFFFFF;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.65rem;
  }

  /* Stats Row */
  .stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
  }

  .stat-card {
    background: #FFFFFF;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    padding: 0.75rem 0.85rem;
  }

  .stat-label {
    font-size: 0.7rem;
    color: var(--text-muted);
    display: block;
    margin-bottom: 0.25rem;
  }

  .stat-val {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text-main);
    margin-bottom: 0.25rem;
  }

  .stat-trend {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--primary-accent);
  }

  .trend-sub {
    color: var(--text-muted);
    font-weight: 400;
  }

  .stat-badge {
    font-size: 0.65rem;
    color: var(--primary);
    background-color: var(--pill-green-bg);
    padding: 0.15rem 0.4rem;
    border-radius: 999px;
    font-weight: 600;
  }

  /* Charts Row */
  .charts-row {
    display: flex;
    gap: 0.75rem;
  }

  .chart-card {
    background: #FFFFFF;
    border: 1px solid var(--border-light);
    border-radius: 12px;
    padding: 0.85rem;
  }

  .flex-2 { flex: 1.4; }
  .flex-1 { flex: 1; }

  .chart-header-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .chart-header {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-main);
  }

  .live-tag {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--primary-accent);
    background-color: var(--pill-green-bg);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    text-transform: uppercase;
  }

  .svg-chart {
    width: 100%;
    height: 75px;
  }

  .chart-days {
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    color: var(--text-muted);
    padding: 0 0.25rem;
    margin-top: 0.25rem;
  }

  .donut-chart-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .donut-svg-wrapper {
    width: 65px;
    height: 65px;
  }

  .donut-svg {
    transform: rotate(-90deg);
  }

  .donut-legend {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    font-size: 0.65rem;
    color: var(--text-secondary);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .color-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
  }

  .dot-op { background-color: #78C800; }
  .dot-tek { background-color: #2563EB; }
  .dot-adm { background-color: #94A3B8; }

  @media (max-width: 1024px) {
    .showcase-container {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .app-window {
      flex-direction: column;
    }
    .app-sidebar {
      width: 100%;
      flex-direction: row;
      justify-content: space-between;
    }
    .stats-row {
      grid-template-columns: 1fr;
    }
    .charts-row {
      flex-direction: column;
    }
  }
</style>
