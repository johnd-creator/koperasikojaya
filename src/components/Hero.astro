---
---
<section class="hero-section" id="top">
  <div class="container hero-container">
    <!-- Left Hero Text & Content -->
    <div class="hero-content" data-animate="fade-up">
      <div class="hero-eyebrow">KOPERASI KOJAYA <span></span> USAHA BERSAMA</div>

      <h1 class="hero-title">
        Tumbuh Bersama melalui <span class="highlight">Gotong Royong</span> & Musyawarah
      </h1>

      <p class="hero-subtitle">
        KOJAYA hadir sebagai wadah usaha bersama yang dikelola secara terbuka dan profesional untuk menciptakan manfaat, kemandirian, dan kesejahteraan anggota secara berkelanjutan.
      </p>

      <div class="hero-actions">
        <a href="#keanggotaan" class="btn-primary">
          <span>Info Keanggotaan</span>
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="#layanan" class="btn-outline">
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          <span>Kemitraan Bisnis</span>
        </a>
      </div>

      <!-- Quick Feature Pills -->
      <div class="hero-pills">
        <div class="pill-item">
          <div class="pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <span>Kesejahteraan Anggota</span>
        </div>

        <div class="pill-item">
          <div class="pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18a1 1 0 0 0 1 1h18a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1H3a1 1 0 0 0-1 1v2z"/><path d="M10 10V5a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1v5"/><path d="M4 15v-3a8 8 0 0 1 16 0v3"/></svg>
          </div>
          <span>Operasional Support</span>
        </div>

        <div class="pill-item">
          <div class="pill-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="7" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
          </div>
          <span>Jasa Profesional</span>
        </div>
      </div>
    </div>

    <!-- Right Hero Isometric Image + One Supporting Proof Point -->
    <div class="hero-visual" data-animate="scale-up" data-delay="200">
      <div class="image-wrapper">
        <img src="/images/main-hero.png" alt="KOJAYA Operasional Pembangkit Ilustrasi" class="hero-img" />
        
        <div class="badge-card badge-top">
          <div class="badge-icon-box bg-light-green">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#0B4A83" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div class="badge-text">
            <h4>Pengelolaan Profesional</h4>
            <p>Proses kerja rapi dan akuntabel.</p>
          </div>
        </div>

      </div>
    </div>
  </div>
</section>

<style>
  .hero-section {
    position: relative;
    padding: 4rem 0 5.5rem 0;
    background: #FFFFFF;
    overflow: hidden;
  }

  .hero-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3.5rem;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 800;
    letter-spacing: 0.14em;
    margin-bottom: 1.25rem;
  }

  .hero-eyebrow span {
    width: 28px;
    height: 2px;
    background: var(--primary-accent);
  }

  /* Left Content */
  .hero-title {
    font-size: 3rem;
    font-weight: 800;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: var(--text-main);
    margin-bottom: 1.25rem;
  }

  .hero-title .highlight {
    color: var(--primary);
  }

  .hero-subtitle {
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    max-width: 540px;
  }

  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  /* Hero Pills Row */
  .hero-pills {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .pill-item {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background-color: #FFFFFF;
    border: 1px solid var(--border-light);
    padding: 0.6rem 1rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-main);
    box-shadow: var(--shadow-sm);
    transition: all 0.25s ease;
  }

  .pill-item:hover {
    border-color: var(--primary-accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
  }

  .pill-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background-color: var(--pill-green-bg);
    color: var(--primary);
    border-radius: 8px;
  }

  /* Right Visual */
  .hero-visual {
    position: relative;
  }

  .image-wrapper {
    position: relative;
    border-radius: 24px;
    padding: 0.5rem;
  }

  .hero-img {
    width: 100%;
    height: auto;
    border-radius: 20px;
    box-shadow: 0 18px 34px -22px rgba(6, 43, 85, 0.55);
    object-fit: cover;
  }

  /* Floating Badges */
  .badge-card {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.85rem;
    background: #FFFFFF;
    border: 1px solid var(--border-light);
    padding: 0.85rem 1.1rem;
    border-radius: 6px;
    box-shadow: var(--shadow-lg);
    width: 270px;
    transition: all 0.3s ease;
  }

  .badge-card:hover {
    box-shadow: var(--shadow-xl);
    border-color: var(--primary-accent);
  }

  .badge-top {
    top: 5%;
    right: -20px;
  }

  .badge-icon-box {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 12px;
    flex-shrink: 0;
  }

  .bg-light-green {
    background-color: var(--pill-green-bg);
  }

  .bg-dark-green {
    background-color: var(--primary-dark);
  }

  .badge-text h4 {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--text-main);
    margin-bottom: 0.15rem;
  }

  .badge-text p {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.3;
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
    }
    
    .badge-card {
      position: static;
      width: 100%;
      margin-top: 1rem;
    }

    .hero-title {
      font-size: 2.25rem;
    }
  }
</style>
