---
---
<header class="site-header">
  <div class="container header-container">
    <!-- Logo -->
    <a href="#" class="logo">
      <img src="/logo.png" alt="Logo KOJAYA" class="logo-icon" />
      <span class="logo-text">KOJAYA</span>
    </a>

    <!-- Desktop Navigation -->
    <nav class="nav-menu" id="nav-menu">
      <ul class="nav-list">
        <li><a href="#top" class="nav-link active">Beranda</a></li>
        <li><a href="#koperasi" class="nav-link">Keanggotaan</a></li>
        <li><a href="#layanan" class="nav-link">Layanan</a></li>
        <li><a href="#solusi" class="nav-link">Solusi</a></li>
        <li><a href="#tentang" class="nav-link">Tentang</a></li>
        <li><a href="#kontak" class="nav-link">Kontak</a></li>
      </ul>
    </nav>

    <!-- Header Actions -->
    <div class="header-actions">
      <a href="#kontak" class="btn-consult">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
        <span>Portal Anggota</span>
      </a>

      <!-- Mobile Hamburger Button -->
      <button class="mobile-toggle" id="mobile-toggle" aria-label="Toggle Menu">
        <span class="bar"></span>
        <span class="bar"></span>
        <span class="bar"></span>
      </button>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    background-color: rgba(255, 255, 255, 0.97);
    border-bottom: 1px solid var(--border-light);
    transition: all 0.3s ease;
  }

  .header-container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 80px;
  }

  /* Logo Styling */
  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .logo-icon {
    width: 34px;
    height: 34px;
    object-fit: contain;
  }

  .logo-text {
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-main);
  }

  /* Navigation Links */
  .nav-list {
    display: flex;
    align-items: center;
    gap: 2.5rem;
    list-style: none;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--text-secondary);
    padding: 0.5rem 0;
    position: relative;
    transition: color 0.2s ease;
  }

  .nav-link:hover {
    color: var(--primary-dark);
  }

  .nav-link.active {
    color: var(--primary-dark);
    font-weight: 700;
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    top: -24px;
    left: 50%;
    transform: translateX(-50%);
    width: 100%;
    height: 3px;
    background-color: var(--primary-dark);
    border-radius: 0 0 3px 3px;
  }

  /* Consult Button */
  .btn-consult {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--primary-dark);
    color: #FFFFFF;
    font-weight: 600;
    font-size: 0.9rem;
    padding: 0.65rem 1.35rem;
    border-radius: 6px;
    transition: all 0.2s ease;
  }

  .btn-consult:hover {
    background-color: var(--primary);
    box-shadow: 0 4px 12px rgba(6, 43, 85, 0.2);
    transform: translateY(-1px);
  }

  /* Mobile Toggle */
  .mobile-toggle {
    display: none;
    flex-direction: column;
    justify-content: space-between;
    width: 24px;
    height: 18px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .mobile-toggle .bar {
    width: 100%;
    height: 2px;
    background-color: var(--text-main);
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  @media (max-width: 900px) {
    .nav-menu {
      position: absolute;
      top: 80px;
      left: 0;
      right: 0;
      background-color: #FFFFFF;
      border-bottom: 1px solid var(--border-light);
      padding: 1.5rem;
      display: none;
      box-shadow: var(--shadow-lg);
    }

    .nav-menu.open {
      display: block;
    }

    .nav-list {
      flex-direction: column;
      gap: 1rem;
      align-items: flex-start;
    }

    .nav-link.active::after {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }
  }
</style>

<script>
  // Mobile Navigation toggle logic
  const mobileToggle = document.getElementById('mobile-toggle');
  const navMenu = document.getElementById('nav-menu');

  if (mobileToggle && navMenu) {
    mobileToggle.addEventListener('click', () => {
      navMenu.classList.toggle('open');
    });

    // Close menu on link click
    document.querySelectorAll('.nav-link').forEach(link => {
      link.addEventListener('click', () => {
        navMenu.classList.remove('open');
      });
    });
  }
</script>
