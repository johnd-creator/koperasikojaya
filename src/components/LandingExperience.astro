<script>
  const setup = () => {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const header = document.querySelector<HTMLElement>('[data-header]');
    const toTop = document.querySelector<HTMLButtonElement>('[data-scroll-top]');

    // ── Hero entrance sequence (runs once on load) ──
    requestAnimationFrame(() => document.body.classList.add('is-loaded'));

    // ── Reveal-on-view system (single IntersectionObserver for all data-reveal) ──
    const revealItems = document.querySelectorAll<HTMLElement>('[data-reveal]');
    if (reduce) {
      revealItems.forEach((el) => el.classList.add('is-visible'));
    } else {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            io.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -5% 0px' });
      revealItems.forEach((el) => io.observe(el));
    }

    // ── Navbar scrolled state via sentinel ──
    const topSentinel = document.querySelector('[data-sentinel-top]');
    if (header && topSentinel) {
      const ho = new IntersectionObserver(([entry]) => {
        header.classList.toggle('is-scrolled', !entry.isIntersecting);
      }, { threshold: 0, rootMargin: '-24px 0px 0px 0px' });
      ho.observe(topSentinel);
    }

    // ── Active section indicator on nav links (Scrollspy) ──
    const navLinks = document.querySelectorAll<HTMLElement>('.nav-links a');
    const sections = ['beranda', 'koperasi', 'keanggotaan', 'ekosistem', 'pt-kbu', 'layanan', 'solusi', 'tentang']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el);

    if (navLinks.length && sections.length) {
      const mapSectionToNavHref = (id: string): string => {
        if (id === 'beranda') return '#beranda';
        if (id === 'koperasi' || id === 'keanggotaan') return '#koperasi';
        if (id === 'ekosistem') return '#ekosistem';
        if (id === 'pt-kbu' || id === 'solusi' || id === 'tentang') return '#pt-kbu';
        if (id === 'layanan') return '#layanan';
        return `#${id}`;
      };

      const so = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const targetHref = mapSectionToNavHref(entry.target.id);
            navLinks.forEach((link) => {
              const isActive = link.getAttribute('href') === targetHref;
              link.classList.toggle('active', isActive);
              if (isActive) link.setAttribute('aria-current', 'true');
              else link.removeAttribute('aria-current');
            });
          }
        });
      }, { rootMargin: '-30% 0px -50% 0px', threshold: 0 });
      sections.forEach((s) => so.observe(s));
    }

    // ── Close mobile nav menu on link click ──
    const mobileNavLinks = document.querySelectorAll('.nav-mobile nav a');
    const mobileDetails = document.querySelector<HTMLDetailsElement>('.nav-mobile');
    mobileNavLinks.forEach((link) => {
      link.addEventListener('click', () => {
        if (mobileDetails) mobileDetails.open = false;
      });
    });

    // ── Back-to-top visibility ──
    const midSentinel = document.querySelector('[data-sentinel-mid]');
    if (toTop && midSentinel) {
      const bo = new IntersectionObserver(([entry]) => {
        toTop.classList.toggle('is-visible', !entry.isIntersecting);
      }, { threshold: 0 });
      bo.observe(midSentinel);
    }
    toTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

    // ── Process timeline progress animation ──
    const timeline = document.querySelector<HTMLElement>('.timeline');
    if (timeline) {
      if (reduce) {
        timeline.classList.add('is-animated');
      } else {
        const to = new IntersectionObserver(([entry]) => {
          if (entry.isIntersecting) {
            timeline.classList.add('is-animated');
            to.unobserve(timeline);
          }
        }, { threshold: 0.25 });
        to.observe(timeline);
      }
    }

    // ── Membership crossfade carousel with auto-pause ──
    const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
    const counter = document.querySelector<HTMLElement>('[data-slide-count]');
    const stage = document.querySelector<HTMLElement>('.members-stage');
    let active = 0;
    let carouselTimer: ReturnType<typeof setTimeout> | undefined;

    const render = (next: number) => {
      active = (next + slides.length) % slides.length;
      slides.forEach((slide, index) => {
        slide.classList.toggle('is-active', index === active);
        slide.setAttribute('aria-hidden', String(index !== active));
      });
      if (counter) counter.textContent = String(active + 1).padStart(2, '0');
    };

    const startAuto = () => {
      if (!reduce && slides.length > 1) {
        carouselTimer = setTimeout(() => render(active + 1), 7000);
      }
    };

    const resetAuto = () => {
      if (carouselTimer) clearTimeout(carouselTimer);
      startAuto();
    };

    const stopAuto = () => {
      if (carouselTimer) clearTimeout(carouselTimer);
    };

    document.querySelector('[data-prev]')?.addEventListener('click', () => { render(active - 1); resetAuto(); });
    document.querySelector('[data-next]')?.addEventListener('click', () => { render(active + 1); resetAuto(); });

    // Pause carousel on hover or keyboard focus for enhanced accessibility
    stage?.addEventListener('mouseenter', stopAuto);
    stage?.addEventListener('mouseleave', resetAuto);
    stage?.addEventListener('focusin', stopAuto);
    stage?.addEventListener('focusout', resetAuto);

    slides.forEach((s) => s.addEventListener('transitionend', () => {
      if (s.classList.contains('is-active')) resetAuto();
    }));

    startAuto();
  };

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup, { once: true });
  else setup();
</script>

