---
import '@phosphor-icons/web/regular';
import '@phosphor-icons/web/bold';

const nav = [
  { label: 'Beranda', href: '#beranda' },
  { label: 'Koperasi', href: '#koperasi' },
  { label: 'Ekosistem', href: '#ekosistem' },
  { label: 'PT KBU', href: '#pt-kbu' },
  { label: 'Layanan', href: '#layanan' }
];

const marqueeItems = [
  'Dukungan Operasional',
  'Manajemen TAD',
  'HR & Payroll',
  'Pengadaan & Support',
  'Jasa Profesional',
  'Layanan Terintegrasi'
];

// Centralized business config - single source of truth for business contact data & routes
// NOTE: Contact numbers, email, and portal URL require business confirmation before production release.
const MEMBER_PORTAL_URL = '/portal'; // Requires business confirmation if external portal domain exists
const CONTACT_WHATSAPP_URL = 'https://wa.me/6281234567890'; // Placeholder number - requires business confirmation
const CONTACT_PHONE_TEL = 'tel:+6281234567890'; // Placeholder number - requires business confirmation
const CONTACT_PHONE_DISPLAY = '+62 812 3456 7890';
const CONTACT_EMAIL = 'info@kojaya.co.id'; // Requires business confirmation
const CONTACT_LOCATION = 'Jakarta, Indonesia';

const footerLegal = [
  { label: 'Kebijakan Privasi', href: '#', pending: true },
  { label: 'Ketentuan Penggunaan', href: '#', pending: true }
];

const coopPillars = [
  {
    num: '01',
    title: 'KEANGGOTAAN',
    desc: 'Anggota menjadi bagian utama dalam pertumbuhan dan ekosistem koperasi.'
  },
  {
    num: '02',
    title: 'TATA KELOLA',
    desc: 'Kegiatan koperasi dikelola secara tertib, transparan, dan profesional.'
  },
  {
    num: '03',
    title: 'PENGEMBANGAN USAHA',
    desc: 'Koperasi mengembangkan kegiatan dan badan usaha untuk menciptakan nilai ekonomi yang berkelanjutan.'
  }
];

const benefits = [
  {
    quote: 'Sisa Hasil Usaha (SHU) dibagikan secara berkala dan akuntabel sesuai besaran partisipasi transaksi serta simpanan setiap anggota.',
    name: 'Pembagian SHU Transparan & Adil',
    role: 'Keanggotaan & kesejahteraan'
  },
  {
    quote: 'Akses fasilitas bantuan dana darurat, pinjaman usaha, dan simpanan anggota dengan bunga yang sangat kompetitif dan proses ramah anggota.',
    name: 'Layanan Simpan Pinjam & Finansial',
    role: 'Manfaat untuk anggota'
  },
  {
    quote: 'Anggota memiliki kesempatan untuk berpartisipasi dalam pengembangan koperasi serta memperoleh manfaat dari pertumbuhan usaha bersama.',
    name: 'Partisipasi & Pengembangan Usaha',
    role: 'Tumbuh bersama KOJAYA'
  }
];

const services = [
  {
    title: 'Dukungan Operasional',
    description: 'PT KBU mendukung kebutuhan operasional mitra melalui layanan yang terencana dan terukur.',
    image: '/images/asset6.png',
    icon: 'ph-factory'
  },
  {
    title: 'Manajemen TAD Profesional',
    description: 'Pengelolaan tenaga alih daya dengan proses administrasi dan operasional yang tertata.',
    image: '/images/asset5.png',
    icon: 'ph-users-three'
  },
  {
    title: 'HR & Payroll',
    description: 'Administrasi SDM, penggajian, dan dokumentasi kerja yang lebih terstruktur.',
    image: '/images/asset4.png',
    icon: 'ph-receipt'
  },
  {
    title: 'Jasa Profesional',
    description: 'Penyediaan tenaga dan layanan profesional sesuai kebutuhan mitra.',
    image: '/images/asset1.png',
    icon: 'ph-briefcase'
  },
  {
    title: 'Pengadaan & Support',
    description: 'Mendukung kebutuhan barang dan layanan penunjang operasional.',
    image: '/images/asset2.png',
    icon: 'ph-package'
  },
  {
    title: 'Layanan Terintegrasi',
    description: 'Solusi terintegrasi untuk mendukung proses, administrasi, dan koordinasi layanan.',
    image: '/images/asset3.png',
    icon: 'ph-tree-structure'
  }
];

const processSteps = [
  {
    title: 'Identifikasi Kebutuhan',
    description: 'Kami memahami kebutuhan operasional dan kondisi mitra secara menyeluruh.',
    icon: 'ph-magnifying-glass'
  },
  {
    title: 'Perencanaan & Penugasan',
    description: 'Menyusun rencana kerja dan menugaskan SDM sesuai kompetensi yang dibutuhkan.',
    icon: 'ph-clipboard-text'
  },
  {
    title: 'Eksekusi & Monitoring',
    description: 'Proses berjalan dengan pengawasan berkala dan pelaporan terukur.',
    icon: 'ph-pulse'
  },
  {
    title: 'Evaluasi & Peningkatan',
    description: 'Kami mengevaluasi hasil dan terus melakukan perbaikan untuk hasil yang lebih baik.',
    icon: 'ph-trend-up'
  }
];

const reasons = [
  { strong: 'Berorientasi pada kebutuhan operasional', small: 'Setiap layanan dirancang untuk mendukung kelancaran kegiatan mitra.' },
  { strong: 'Pendekatan profesional dan adaptif', small: 'Kami menyesuaikan solusi sesuai kebutuhan dan dinamika operasional mitra.' },
  { strong: 'Pengelolaan SDM dan administrasi lebih rapi', small: 'Proses tertata, terukur, dan mudah dipantau.' },
  { strong: 'Mitra yang siap tumbuh bersama', small: 'Kami membangun hubungan kerja jangka panjang yang berkelanjutan.' }
];
---

<div class="shell">
  <a class="skip-link" href="#konten">Lewati ke konten utama</a>
  <span class="sentinel" data-sentinel-top aria-hidden="true"></span>

  {/* ───────────────── 01. NAVBAR ───────────────── */}
  <header class="nav" data-header>
    <div class="nav-inner">
      <a class="brand" href="#beranda" aria-label="KOJAYA, kembali ke beranda">
        <img class="brand-logo" src="/logo1.png" alt="KOJAYA" />
      </a>

      <nav class="nav-links" aria-label="Navigasi utama">
        {nav.map((item, index) => (
          <a href={item.href} class:list={[{ active: index === 0 }]}>{item.label}</a>
        ))}
      </nav>

      <div class="nav-actions">
        <a class="nav-portal" href={MEMBER_PORTAL_URL}>
          <i class="ph ph-user-circle" aria-hidden="true"></i>
          <span>Portal Anggota</span>
        </a>
        <a class="nav-cta" href="#kontak">
          <span>Konsultasi</span>
          <i class="ph ph-arrow-up-right" aria-hidden="true"></i>
        </a>
      </div>

      <details class="nav-mobile">
        <summary aria-label="Buka menu navigasi">
          <span></span><span></span>
        </summary>
        <nav aria-label="Navigasi mobile">
          <a href="#beranda">Beranda</a>
          <div class="mobile-group-label">Koperasi KOJAYA</div>
          <a href="#koperasi">Tentang Koperasi</a>
          <a href="#keanggotaan">Manfaat Anggota</a>
          <a href="#ekosistem">Ekosistem Usaha</a>
          <div class="mobile-group-label">PT Kojaya Berkah Usaha</div>
          <a href="#pt-kbu">Tentang PT KBU</a>
          <a href="#layanan">Layanan Bisnis</a>
          <a href="#solusi">Proses Kerja</a>
          <a href="#tentang">Mengapa PT KBU</a>
          <div class="mobile-divider"></div>
          <a class="mobile-portal" href={MEMBER_PORTAL_URL}>
            <i class="ph ph-user-circle" aria-hidden="true"></i>
            <span>Portal Anggota</span>
          </a>
          <a class="mobile-cta" href="#kontak">Konsultasi</a>
        </nav>
      </details>
    </div>
  </header>

  <main id="konten">
    {/* ─────────────────────────────────────────────────────────────
        CHAPTER 1: KOPERASI KOJAYA
       ───────────────────────────────────────────────────────────── */}

    {/* ───────────────── 02. HERO — ONLY KOPERASI KOJAYA ───────────────── */}
    <section id="beranda" class="hero" aria-labelledby="hero-title">
      <div class="hero-orb hero-orb-a" aria-hidden="true"></div>
      <div class="hero-orb hero-orb-b" aria-hidden="true"></div>

      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow hero-enter" style="--ei:1"><span class="eyebrow-line"></span> Koperasi KOJAYA <span class="eyebrow-tag">Usaha Bersama</span></p>
          <h1 id="hero-title" class="hero-enter" style="--ei:2">Tumbuh Bersama melalui <em>Gotong Royong</em> &amp; Musyawarah</h1>
          <p class="hero-sub hero-enter" style="--ei:3">Koperasi KOJAYA membangun ekosistem usaha bersama yang berorientasi pada kesejahteraan anggota melalui tata kelola profesional dan pengembangan usaha yang berkelanjutan.</p>
          <div class="hero-actions hero-enter" style="--ei:4">
            <a class="btn btn-primary" href="#koperasi">Kenali KOJAYA <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
            <a class="btn btn-ghost" href="#ekosistem">Lihat Ekosistem Usaha <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          </div>
        </div>

        <div class="hero-media hero-enter" style="--ei:5">
          <div class="hero-frame">
            <img src="/images/main-hero.png" alt="Ilustrasi keanggotaan dan operasional Koperasi KOJAYA" />
          </div>
          <div class="media-glow" aria-hidden="true"></div>

          <figure class="chip chip-top">
            <span class="chip-ico"><i class="ph-bold ph-shield-check" aria-hidden="true"></i></span>
            <span><strong>Pengelolaan Profesional</strong><small>Proses kerja rapi &amp; akuntabel</small></span>
          </figure>

          <figure class="chip chip-bottom">
            <span class="chip-status" aria-hidden="true"></span>
            <span><strong>Kesejahteraan Anggota</strong><small>Partisipasi &amp; Transparansi</small></span>
          </figure>

          <p class="hero-note"><span class="live-dot" aria-hidden="true"></span> Dikelola secara terbuka dan profesional</p>
        </div>
      </div>
    </section>

    {/* ───────────────── 03. TENTANG KOPERASI KOJAYA (EDITORIAL LAYOUT) ───────────────── */}
    <section id="koperasi" class="coop-about sec" aria-labelledby="coop-about-title">
      <div class="container">
        <header class="sec-head" data-reveal>
          <p class="eyebrow"><span class="eyebrow-line"></span> TENTANG KOPERASI KOJAYA</p>
          <h2 id="coop-about-title">Wadah Usaha Bersama untuk <em>Tumbuh dan Sejahtera</em></h2>
          <p class="sec-lead">Koperasi KOJAYA hadir sebagai wadah bagi anggota untuk tumbuh bersama melalui partisipasi, tata kelola yang profesional, serta pengembangan usaha yang berkelanjutan.</p>
        </header>

        <div class="coop-pillars-grid" data-reveal>
          {coopPillars.map((pillar) => (
            <div class="coop-pillar-item">
              <div class="pillar-top">
                <span class="pillar-num">{pillar.num}</span>
                <h3 class="pillar-badge">{pillar.title}</h3>
              </div>
              <p class="pillar-desc">{pillar.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ───────────────── 04. KEANGGOTAAN & MANFAAT ANGGOTA ───────────────── */}
    <section id="keanggotaan" class="members sec" aria-labelledby="members-title">
      <div class="container members-grid">
        <div class="members-aside">
          <p class="eyebrow"><span class="eyebrow-line"></span> KOPERASI KOJAYA • MANFAAT ANGGOTA</p>
          <h2 id="members-title">Tumbuh Bersama <em>Anggota Sejahtera</em></h2>
          <p class="members-lead">Koperasi KOJAYA menempatkan kesejahteraan anggota sebagai salah satu tujuan utama melalui pengelolaan usaha yang sehat, manfaat keanggotaan, serta pembagian hasil yang transparan dan berkelanjutan.</p>

          <div class="members-portal-wrap">
            <a class="members-portal-link" href={MEMBER_PORTAL_URL}>
              <i class="ph ph-user-circle" aria-hidden="true"></i>
              <span>Masuk Portal Anggota</span>
              <i class="ph ph-arrow-right" aria-hidden="true"></i>
            </a>
          </div>

          <div class="members-ctrl">
            <button type="button" class="ctrl-btn" data-prev aria-label="Manfaat sebelumnya"><i class="ph-bold ph-arrow-left" aria-hidden="true"></i></button>
            <button type="button" class="ctrl-btn" data-next aria-label="Manfaat berikutnya"><i class="ph-bold ph-arrow-right" aria-hidden="true"></i></button>
            <span class="ctrl-count"><b data-slide-count>01</b> / 03</span>
          </div>
        </div>

        <div class="members-stage" data-reveal>
          {benefits.map((benefit, index) => (
            <article class:list={["slide", { "is-active": index === 0 }]} data-slide={index} aria-hidden={index !== 0}>
              <p class="slide-eyebrow">Manfaat Anggota</p>
              <span class="slide-quote"><i class="ph-fill ph-quotes" aria-hidden="true"></i></span>
              <blockquote>{benefit.quote}</blockquote>
              <div class="slide-foot">
                <strong>{benefit.name}</strong>
                <small>{benefit.role}</small>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ─────────────────────────────────────────────────────────────
        TRANSITION: BRIDGE TO BUSINESS CHAPTER
       ───────────────────────────────────────────────────────────── */}

    {/* ───────────────── 05. TRANSITION: PENGEMBANGAN EKOSISTEM USAHA ───────────────── */}
    <section id="ekosistem" class="transition-sec sec" aria-label="Pengembangan Ekosistem Usaha KOJAYA">
      <div class="container transition-inner">
        <header class="transition-head" data-reveal>
          <p class="kicker"><i class="ph ph-git-fork" aria-hidden="true"></i> PENGEMBANGAN EKOSISTEM USAHA</p>
          <h2 class="transition-title">
            Koperasi KOJAYA mengembangkan badan usaha untuk menciptakan nilai ekonomi yang <em>berkelanjutan</em> dan memperluas manfaat bagi anggota.
          </h2>
          <p class="transition-sub">
            PT Kojaya Berkah Usaha (KBU) merupakan salah satu anak usaha Koperasi KOJAYA yang menjalankan layanan bisnis dan operasional secara profesional.
          </p>
        </header>

        <div class="transition-relationship" data-reveal>
          <div class="rel-entity rel-parent">
            <span class="rel-label">Wadah Utama &amp; Induk Koperasi</span>
            <h3 class="rel-name">KOPERASI KOJAYA</h3>
            <p class="rel-desc">Ekosistem Koperasi &amp; Kesejahteraan Anggota</p>
          </div>

          <div class="rel-connector" aria-hidden="true">
            <span class="rel-line"></span>
            <span class="rel-text">ANAK USAHA</span>
            <span class="rel-line"></span>
          </div>

          <div class="rel-entity rel-child">
            <span class="rel-label rel-label-kbu">Layanan Bisnis &amp; Operasional</span>
            <h3 class="rel-name">PT KOJAYA BERKAH USAHA</h3>
            <p class="rel-desc">Operasional Profesional &amp; Commercial</p>
          </div>
        </div>
      </div>
    </section>

    <span class="sentinel" data-sentinel-mid aria-hidden="true"></span>

    {/* ─────────────────────────────────────────────────────────────
        CHAPTER 2: PT KOJAYA BERKAH USAHA (PT KBU)
       ───────────────────────────────────────────────────────────── */}

    {/* ───────────────── 06. INTRODUCTION: PT KOJAYA BERKAH USAHA ───────────────── */}
    <section id="pt-kbu" class="kbu-intro" aria-labelledby="kbu-intro-title">
      <div class="container">
        <header class="sec-head kbu-head" data-reveal>
          <p class="eyebrow"><span class="eyebrow-line"></span> ANAK USAHA KOJAYA <span class="eyebrow-tag">Layanan Bisnis &amp; Operasional</span></p>
          <h2 id="kbu-intro-title">PT Kojaya Berkah Usaha</h2>
          <p class="sec-lead">PT Kojaya Berkah Usaha (KBU) merupakan salah satu anak usaha Koperasi KOJAYA yang menjalankan kegiatan bisnis dan layanan profesional untuk mendukung kebutuhan operasional mitra.</p>
        </header>
      </div>
    </section>

    {/* ───────────────── 07. TICKER: SERVICES MARQUEE (SAFE TWO-ZONE) ───────────────── */}
    <section class="marquee-bar" aria-label="Layanan bisnis PT Kojaya Berkah Usaha">
      <div class="marquee-static">
        <span class="static-label">PT KBU</span>
        <span class="static-dot" aria-hidden="true"></span>
        <span class="static-sub">LAYANAN BISNIS</span>
      </div>
      <div class="marquee-viewport">
        <div class="marquee-track">
          {marqueeItems.map((item) => (
            <span class="marquee-item">
              {item}<span class="marquee-dot" aria-hidden="true"></span>
            </span>
          ))}
          {marqueeItems.map((item) => (
            <span class="marquee-item" aria-hidden="true">
              {item}<span class="marquee-dot" aria-hidden="true"></span>
            </span>
          ))}
        </div>
      </div>
    </section>

    {/* ───────────────── 08. LAYANAN BISNIS PT KBU (BENTO GRID) ───────────────── */}
    <section id="layanan" class="services sec" aria-labelledby="services-title">
      <div class="container">
        <header class="sec-head" data-reveal>
          <p class="eyebrow"><span class="eyebrow-line"></span> LAYANAN BISNIS PT KBU</p>
          <h2 id="services-title">Layanan Bisnis &amp; <em>Operasional</em></h2>
          <p class="sec-lead">PT KBU menghadirkan layanan profesional yang dirancang untuk mendukung kebutuhan operasional mitra secara terencana, terstruktur, dan adaptif.</p>
        </header>

        <div class="bento">
          {services.map((service, index) => (
            <article class:list={["svc", { "svc-lead": index === 0, "svc-wide": index === 1, "svc-wide-x": index === 5 }]} data-reveal tabindex="0">
              <img class="svc-img" src={service.image} alt="" loading={index > 1 ? 'lazy' : 'eager'} />
              <div class="svc-shade"></div>
              <div class="svc-top">
                <span class="svc-num">{String(index + 1).padStart(2, '0')}</span>
                <span class="svc-ico"><i class={`ph-bold ${service.icon}`} aria-hidden="true"></i></span>
              </div>
              <div class="svc-copy">
                <h3>{service.title}</h3>
                <p>{service.description}</p>
              </div>
              <i class="ph ph-arrow-up-right svc-arrow" aria-hidden="true"></i>
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* ───────────────── 09. PROSES KERJA PT KBU (TIMELINE) ───────────────── */}
    <section id="solusi" class="process sec" aria-labelledby="process-title">
      <div class="container">
        <header class="sec-head sec-head-process" data-reveal>
          <p class="kicker"><i class="ph ph-path" aria-hidden="true"></i> STANDAR LAYANAN PT KBU</p>
          <h2 id="process-title">Proses Kerja yang <em>Terstruktur</em></h2>
          <p class="sec-lead">Setiap kebutuhan mitra ditangani melalui proses yang terencana, terukur, dan dapat dipantau untuk memastikan layanan berjalan efektif dan sesuai kebutuhan operasional.</p>
        </header>

        <ol class="timeline">
          <span class="timeline-base" aria-hidden="true"></span>
          <span class="timeline-progress" aria-hidden="true"></span>
          {processSteps.map((step, index) => (
            <li class="t-step" style={`--d:${(index * 0.15).toFixed(2)}s`}>
              <div class="t-marker">
                <span class="t-ico"><i class={`ph-bold ${step.icon}`} aria-hidden="true"></i></span>
                <span class="t-num">{String(index + 1).padStart(2, '0')}</span>
              </div>
              <div class="t-body">
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {/* ───────────────── 10. MENGAPA MEMILIH PT KBU ───────────────── */}
    <section id="tentang" class="proof sec" aria-labelledby="proof-title">
      <div class="container proof-grid">
        <div class="proof-media" data-reveal>
          <img src="/images/asset3.png" alt="Tim PT KBU berdiskusi profesional tentang operasional mitra" />
          <span class="proof-caption">Dibangun untuk kerja nyata</span>
        </div>
        <div class="proof-copy">
          <p class="kicker"><i class="ph ph-seal-check" aria-hidden="true"></i> MITRA LAYANAN PROFESIONAL</p>
          <h2 id="proof-title">Mengapa Memilih <em>PT KBU</em>?</h2>
          <p class="proof-lead">Sebagai salah satu anak usaha Koperasi KOJAYA, PT KBU menjalankan layanan bisnis dengan pendekatan profesional, terstruktur, dan adaptif untuk mendukung kebutuhan operasional mitra.</p>

          <ol class="reasons">
            {reasons.map((reason, index) => (
              <li data-reveal>
                <span class="r-num">{String(index + 1).padStart(2, '0')}</span>
                <div><strong>{reason.strong}</strong><small>{reason.small}</small></div>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    {/* ───────────────── 11. FINAL BUSINESS CTA PT KBU (CENTERED) ───────────────── */}
    <section id="kontak" class="cta sec" aria-labelledby="cta-title">
      <div class="cta-glow" aria-hidden="true"></div>
      <div class="container cta-inner">
        <p class="cta-kicker">KOLABORASI BISNIS</p>
        <h2 id="cta-title">Bangun Kolaborasi Bersama <em>PT KBU</em></h2>
        <p class="cta-lead">Diskusikan kebutuhan operasional dan peluang kemitraan bersama PT Kojaya Berkah Usaha.</p>
        <div class="cta-actions">
          <a class="btn btn-light" href={CONTACT_WHATSAPP_URL} target="_blank" rel="noopener noreferrer">Jadwalkan Konsultasi <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
          <a class="btn btn-ghost-light" href="#layanan">Lihat Layanan PT KBU <i class="ph ph-arrow-up-right" aria-hidden="true"></i></a>
        </div>
      </div>
    </section>
  </main>

  {/* ───────────────── 12. FOOTER ───────────────── */}
  <footer class="footer">
    <div class="container footer-grid">
      <div class="footer-brand">
        <a class="brand brand-footer" href="#beranda"><img class="brand-logo" src="/logo-white.png" alt="KOJAYA" /></a>
        <p>Koperasi KOJAYA merupakan wadah usaha bersama yang mengembangkan manfaat ekonomi dan kesejahteraan anggota melalui kegiatan koperasi serta pengembangan badan usaha.</p>
        <p class="footer-note">PT Kojaya Berkah Usaha merupakan salah satu anak usaha Koperasi KOJAYA.</p>
      </div>
      <div class="footer-col">
        <p>Koperasi KOJAYA</p>
        <a href="#koperasi">Tentang Koperasi</a>
        <a href="#keanggotaan">Manfaat Anggota</a>
        <a href={MEMBER_PORTAL_URL}>Portal Anggota</a>
      </div>
      <div class="footer-col">
        <p>PT Kojaya Berkah Usaha</p>
        <a href="#pt-kbu">Tentang PT KBU</a>
        <a href="#layanan">Layanan Bisnis</a>
        <a href="#kontak">Konsultasi</a>
      </div>
      <div class="footer-col">
        <p>Kontak</p>
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
