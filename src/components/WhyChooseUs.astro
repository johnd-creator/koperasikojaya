---
const advantages = [
  {
    title: "Berorientasi pada kebutuhan operasional",
    description: "Setiap layanan dirancang untuk mendukung kelancaran kegiatan mitra."
  },
  {
    title: "Pendekatan profesional dan adaptif",
    description: "Kami menyesuaikan solusi sesuai kebutuhan dan dinamika operasional mitra."
  },
  {
    title: "Pengelolaan SDM dan administrasi lebih rapi",
    description: "Proses tertata, akurat, dan mudah dipantau."
  },
  {
    title: "Mitra yang siap tumbuh bersama",
    description: "Kami membangun kolaborasi jangka panjang yang berkelanjutan."
  }
];
---

<section class="why-choose-section" id="tentang">
  <div class="container why-choose-container">
    <!-- Left Column: Industrial Team Image -->
    <div class="image-column">
      <div class="photo-wrapper">
        <img src="/images/asset3.png" alt="Tim Profesional Koperasi KOJAYA" class="team-photo" />
      </div>
    </div>

    <!-- Right Column: Content & Advantages -->
    <div class="content-column">
      <h2 class="section-title">
        Mengapa Memilih <span class="highlight">KOJAYA</span>?
      </h2>
      <p class="section-desc">
        KOJAYA adalah koperasi yang terus meningkatkan proses bisnisnya untuk menjadi mitra profesional yang kredibel, terpercaya, dan siap mendukung kebutuhan operasional pembangkit dan industri.
      </p>

      <div class="advantages-grid">
        {advantages.map((item) => (
          <div class="advantage-item">
            <div class="check-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
            </div>
            <div class="advantage-text">
              <h3 class="item-title">{item.title}</h3>
              <p class="item-desc">{item.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .why-choose-section {
    padding: 6rem 0;
    background-color: #FFFFFF;
  }

  .why-choose-container {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 4rem;
    align-items: center;
  }

  .photo-wrapper {
    position: relative;
    border-radius: 24px;
    overflow: hidden;
    box-shadow: var(--shadow-xl);
    border: 1px solid var(--border-light);
  }

  .team-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .photo-wrapper:hover .team-photo {
    transform: scale(1.02);
  }

  .highlight {
    color: var(--primary);
  }

  .section-desc {
    font-size: 1.025rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-top: 1rem;
    margin-bottom: 2.25rem;
  }

  .advantages-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem 1.5rem;
  }

  .advantage-item {
    display: flex;
    align-items: flex-start;
    gap: 0.85rem;
  }

  .check-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    background-color: var(--primary-dark);
    border-radius: 50%;
    flex-shrink: 0;
    margin-top: 0.15rem;
  }

  .item-title {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-main);
    line-height: 1.35;
    margin-bottom: 0.25rem;
  }

  .item-desc {
    font-size: 0.825rem;
    color: var(--text-secondary);
    line-height: 1.45;
  }

  @media (max-width: 1024px) {
    .why-choose-container {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .advantages-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
